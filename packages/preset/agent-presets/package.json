{
  "name": "@daoai/dao-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Dao",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/cordis-plugin-include": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-atomic-write": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-home-paths": "workspace:^",
    "@daoai/dao-scope": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-projection": "workspace:^",
    "@daoai/dao-settings": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@daoai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@daoai/cordis-plugin-group": "workspace:^",
    "@daoai/cordis-plugin-include": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-loop": "workspace:^",
    "@daoai/dao-atomic-write": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-home-paths": "workspace:^",
    "@daoai/dao-scope": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-projection": "workspace:^",
    "@daoai/dao-settings": "workspace:^",
    "@daoai/dao-settings-file": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^",
    "@daoai/cordis": "workspace:^"
  }
}
