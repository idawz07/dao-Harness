{
  "name": "@daoai/dao-subagent-dao-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Dao runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dao-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-sdk-client": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-subprocess": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "dependencies": {
    "@daoai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-instructions": "workspace:^",
    "@daoai/dao-agent-spine-demo": "workspace:^",
    "@daoai/dao-app-boot": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-llm-deepseek": "workspace:^",
    "@daoai/dao-loader-smoke": "workspace:^",
    "@daoai/dao-sdk-client": "workspace:^",
    "@daoai/dao-sdk-protocol": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-checkpoint-policy": "workspace:^",
    "@daoai/dao-session-persistence-jsonl": "workspace:^",
    "@daoai/dao-skill-filesystem": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-subprocess": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tool-subagent": "workspace:^",
    "@daoai/cordis": "workspace:^"
  }
}
