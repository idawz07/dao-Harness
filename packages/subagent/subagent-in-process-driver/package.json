{
  "name": "@daoai/dao-subagent-in-process-driver",
  "description": "Shared in-process subagent run driver: drives a child agent on ctx.agents (used by the spawn and fork backends)",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-in-process-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@daoai/cordis-plugin-include": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-loop": "workspace:^",
    "@daoai/dao-agent-loop-testkit": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-fs-sandbox": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-sandbox-policy": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tool-fs": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/dao-user-approval": "workspace:^",
    "@daoai/cordis": "workspace:^"
  }
}
