{
  "name": "@daoai/dao-client-ui-workflow-run",
  "description": "Durable workflow-run Conversation Node and nested member disclosure for dao web",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-workflow-run"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dao": {
    "client": {
      "inject": [
        "@daoai/dao-api-session-controller",
        "@daoai/dao-client-locale",
        "@daoai/dao-client-ui-chat",
        "@daoai/dao-client-ui-conversation",
        "@daoai/dao-client-ui-renderer",
        "@daoai/dao-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/dao-api-session-controller": "workspace:^",
    "@daoai/dao-client-locale": "workspace:^",
    "@daoai/dao-client-ui-chat": "workspace:^",
    "@daoai/dao-client-ui-conversation": "workspace:^",
    "@daoai/dao-client-ui-renderer": "workspace:^",
    "@daoai/dao-client-ui-session": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-tool-workflow": "workspace:^",
    "@daoai/dao-workflow": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@daoai/dao-api-session-controller": "workspace:^",
    "@daoai/dao-client-locale": "workspace:^",
    "@daoai/dao-client-store": "workspace:^",
    "@daoai/dao-client-test-runtime": "workspace:^",
    "@daoai/dao-client-ui-chat": "workspace:^",
    "@daoai/dao-client-ui-conversation": "workspace:^",
    "@daoai/dao-client-ui-primitives": "workspace:^",
    "@daoai/dao-client-ui-slots": "workspace:^",
    "@daoai/dao-client-ui-renderer": "workspace:^",
    "@daoai/dao-client-ui-session": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-tool-workflow": "workspace:^",
    "@daoai/dao-workflow": "workspace:^",
    "@types/react": "~18.3.1",
    "@daoai/cordis": "workspace:^",
    "react": "^18.2.0"
  }
}
