{
  "name": "@daoai/dao-client-ui-model-selection",
  "description": "Model selection over the shared model catalog, Session projection, and session.selectModel",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/client/ui-model-selection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dao": {
    "client": {
      "inject": [
        "@daoai/dao-api-session-controller",
        "@daoai/dao-client-locale",
        "@daoai/dao-client-ui-commands",
        "@daoai/dao-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@daoai/dao-api-remotes": "workspace:^",
    "@daoai/dao-api-session-controller": "workspace:^",
    "@daoai/dao-client-locale": "workspace:^",
    "@daoai/dao-client-ui-commands": "workspace:^",
    "@daoai/dao-client-ui-conversation": "workspace:^",
    "@daoai/dao-client-ui-input-trigger": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^",
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-client-ui-renderer": "workspace:^",
    "@daoai/dao-client-ui-session": "workspace:^"
  },
  "devDependencies": {
    "@daoai/dao-api-remotes": "workspace:^",
    "@daoai/dao-api-session-controller": "workspace:^",
    "@daoai/dao-client-locale": "workspace:^",
    "@daoai/dao-client-test-runtime": "workspace:^",
    "@daoai/dao-client-ui-commands": "workspace:^",
    "@daoai/dao-client-ui-conversation": "workspace:^",
    "@daoai/dao-client-ui-input-trigger": "workspace:^",
    "@daoai/dao-client-ui-primitives": "workspace:^",
    "@daoai/dao-client-ui-slots": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^",
    "@types/react": "~19.2.18",
    "@daoai/cordis": "workspace:^",
    "react": "^19.2.8",
    "@daoai/dao-client-store": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-client-ui-renderer": "workspace:^",
    "@daoai/dao-client-ui-session": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
