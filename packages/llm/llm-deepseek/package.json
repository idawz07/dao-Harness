{
  "name": "@daoai/dao-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for the Dao LLM seam",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
