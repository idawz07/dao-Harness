{
  "name": "@daoai/dao-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Dao filesystem seam (ctx.fs)",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@daoai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@daoai/dao-attachment": "workspace:^",
    "@daoai/dao-fs": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-sandbox": "workspace:^",
    "@daoai/dao-sandbox-policy": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/dao-user-approval": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-loop": "workspace:^",
    "@daoai/dao-agent-loop-testkit": "workspace:^",
    "@daoai/dao-attachment": "workspace:^",
    "@daoai/dao-fs": "workspace:^",
    "@daoai/dao-fs-local": "workspace:^",
    "@daoai/dao-fs-observation-policy": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-sandbox": "workspace:^",
    "@daoai/dao-sandbox-policy": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/dao-user-approval": "workspace:^",
    "@daoai/cordis": "workspace:^"
  }
}
