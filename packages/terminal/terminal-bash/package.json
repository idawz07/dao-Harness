{
  "name": "@daoai/dao-terminal-bash",
  "description": "Persistent shell PTY backend over the Dao subprocess terminal primitive",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-terminal": "workspace:^",
    "@daoai/dao-sandbox": "workspace:^",
    "@daoai/dao-sandbox-policy": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-subprocess": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "dependencies": {
    "@daoai/dao-pwsh-local": "workspace:^",
    "@daoai/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-terminal": "workspace:^",
    "@daoai/dao-sandbox": "workspace:^",
    "@daoai/dao-sandbox-policy": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-subprocess": "workspace:^",
    "@daoai/dao-subprocess-local": "workspace:^",
    "@daoai/cordis": "workspace:^"
  }
}
