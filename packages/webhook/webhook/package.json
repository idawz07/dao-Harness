{
  "name": "@daoai/dao-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Dao Sessions",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/webhook/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-default-model": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-brand": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-permission-presets": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-title": "workspace:^",
    "@daoai/dao-workspace": "workspace:^"
  },
  "devDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/cordis-plugin-include": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-default-model": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-brand": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-permission-presets": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-title": "workspace:^",
    "@daoai/dao-workspace": "workspace:^"
  }
}
