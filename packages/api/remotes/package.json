{
  "name": "@daoai/dao-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dao": {
    "client": {
      "inject": [
        "@daoai/dao-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@daoai/dao-scope": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-api-gateway": "workspace:^",
    "@daoai/dao-api-session-controller": "workspace:^",
    "@daoai/dao-api-settings-controller": "workspace:^",
    "@daoai/dao-api-workspace-controller": "workspace:^",
    "@daoai/dao-commands": "workspace:^",
    "@daoai/dao-cordis-host-runner": "workspace:^",
    "@daoai/dao-credentials": "workspace:^",
    "@daoai/dao-file-reference": "workspace:^",
    "@daoai/dao-goal": "workspace:^",
    "@daoai/dao-host-plugin-inventory": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-message-feedback": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-reference": "workspace:^",
    "@daoai/dao-settings": "workspace:^",
    "@daoai/dao-squad-draft": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-user-approval": "workspace:^",
    "@daoai/dao-user-questions": "workspace:^"
  },
  "devDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-api-gateway": "workspace:^",
    "@daoai/dao-api-session-controller": "workspace:^",
    "@daoai/dao-api-settings-controller": "workspace:^",
    "@daoai/dao-api-workspace-controller": "workspace:^",
    "@daoai/dao-commands": "workspace:^",
    "@daoai/dao-cordis-host-runner": "workspace:^",
    "@daoai/dao-credentials": "workspace:^",
    "@daoai/dao-file-reference": "workspace:^",
    "@daoai/dao-goal": "workspace:^",
    "@daoai/dao-host-plugin-inventory": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-message-feedback": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-reference": "workspace:^",
    "@daoai/dao-settings": "workspace:^",
    "@daoai/dao-squad-draft": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-user-approval": "workspace:^",
    "@daoai/dao-user-questions": "workspace:^"
  }
}
