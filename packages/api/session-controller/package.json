{
  "name": "@daoai/dao-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dao": {
    "client": {
      "external": [
        "@daoai/dao-api-gateway/client"
      ],
      "inject": [
        "@daoai/dao-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@daoai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-default-model": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-api-gateway": "workspace:^",
    "@daoai/dao-attachment": "workspace:^",
    "@daoai/dao-brand": "workspace:^",
    "@daoai/dao-client-connection": "workspace:^",
    "@daoai/dao-file-reference": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-jobs": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-native-command": "workspace:^",
    "@daoai/dao-scope": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-persistence": "workspace:^",
    "@daoai/dao-session-projection": "workspace:^",
    "@daoai/dao-session-projection-cache": "workspace:^",
    "@daoai/dao-session-query": "workspace:^",
    "@daoai/dao-skill": "workspace:^",
    "@daoai/dao-session-title": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^",
    "@daoai/dao-typert-registry": "workspace:^",
    "@daoai/dao-workspace": "workspace:^",
    "@daoai/dao-util-workspace-path": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@daoai/dao-jobs": { "optional": true },
    "@daoai/dao-session-persistence": { "optional": true },
    "@daoai/dao-session-projection-cache": { "optional": true }
  },
  "devDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-default-model": "workspace:^",
    "@daoai/dao-agent-presets": "workspace:^",
    "@daoai/dao-api-gateway": "workspace:^",
    "@daoai/dao-attachment": "workspace:^",
    "@daoai/dao-brand": "workspace:^",
    "@daoai/dao-client-connection": "workspace:^",
    "@daoai/dao-client-store": "workspace:^",
    "@daoai/dao-file-reference": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-jobs": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-native-command": "workspace:^",
    "@daoai/dao-permission-presets": "workspace:^",
    "@daoai/dao-scope": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-persistence": "workspace:^",
    "@daoai/dao-session-projection": "workspace:^",
    "@daoai/dao-session-projection-cache": "workspace:^",
    "@daoai/dao-session-query": "workspace:^",
    "@daoai/dao-skill": "workspace:^",
    "@daoai/dao-session-title": "workspace:^",
    "@daoai/dao-subagent": "workspace:^",
    "@daoai/dao-typert-protocol": "workspace:^",
    "@daoai/dao-typert-registry": "workspace:^",
    "@daoai/dao-util-crypto": "workspace:^",
    "@daoai/dao-workspace": "workspace:^",
    "@daoai/dao-util-workspace-path": "workspace:^"
  }
}
