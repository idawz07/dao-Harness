{
  "name": "@daoai/dao-experimental-inspector",
  "description": "Experimental cross-realm CDP hub for Host debugging and Client Runtime inspection",
  "version": "0.1.2-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/experimental/inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dao": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@daoai/dao-brand": "workspace:^",
    "@daoai/dao-util-crypto": "workspace:^",
    "@daoai/schemastery": "workspace:^",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-client-modules": "workspace:^",
    "@daoai/dao-host-webserver": "workspace:^",
    "@daoai/dao-invariants": "workspace:^"
  },
  "devDependencies": {
    "@daoai/cordis": "workspace:^",
    "@daoai/cordis-plugin-include": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-host-webserver": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2"
  }
}
