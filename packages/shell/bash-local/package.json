{
  "name": "@daoai/dao-bash-local",
  "description": "Local-subprocess implementation of the Dao bash executor seam",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@daoai/dao-shell": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-subprocess": "workspace:^",
    "@daoai/dao-timeout": "workspace:^",
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-settings": "workspace:^"
  },
  "dependencies": {
    "@daoai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@daoai/dao-shell": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-subprocess": "workspace:^",
    "@daoai/dao-subprocess-local": "workspace:^",
    "@daoai/dao-timeout": "workspace:^",
    "@daoai/cordis": "workspace:^",
    "@daoai/dao-settings": "workspace:^"
  }
}
