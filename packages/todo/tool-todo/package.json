{
  "name": "@daoai/dao-tool-todo",
  "description": "Model-facing todo_write tool over the Dao event-sourced session log",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoAI/dao.git",
    "directory": "packages/todo/tool-todo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@daoai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-projection": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@daoai/cordis-plugin-include": "workspace:^",
    "@daoai/cordis-plugin-loader": "workspace:^",
    "@daoai/dao-agent": "workspace:^",
    "@daoai/dao-agent-loop": "workspace:^",
    "@daoai/dao-agent-loop-testkit": "workspace:^",
    "@daoai/dao-invariants": "workspace:^",
    "@daoai/dao-llm": "workspace:^",
    "@daoai/dao-session": "workspace:^",
    "@daoai/dao-session-projection": "workspace:^",
    "@daoai/dao-system-prompt": "workspace:^",
    "@daoai/dao-tools": "workspace:^",
    "@daoai/dao-user-questions": "workspace:^",
    "@daoai/cordis": "workspace:^"
  }
}
